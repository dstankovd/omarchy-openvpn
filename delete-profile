#!/bin/bash
# Delete a VPN profile. A profile that is connected or connecting is
# disconnected first, so its tunnel never outlives the profile.

profile_uuid=${1:-}

if [[ ! "$profile_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  echo "Invalid VPN profile UUID."
  exit 2
fi

profile_type=$(nmcli -g connection.type connection show uuid "$profile_uuid" 2>/dev/null)
if [[ "$profile_type" != "vpn" ]]; then
  echo "The selected connection is not a VPN profile."
  exit 2
fi

profile_state=$(nmcli -g GENERAL.STATE connection show uuid "$profile_uuid" 2>/dev/null)
case "$profile_state" in
  activated* | activating*)
    if ! nmcli connection down uuid "$profile_uuid"; then
      echo "Could not disconnect the profile, so it was not deleted." >&2
      exit 3
    fi
    ;;
esac

nmcli connection delete uuid "$profile_uuid"
