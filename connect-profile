#!/bin/bash

set -o pipefail

profile_uuid=${1:-}
remember=0
if [[ "${2:-}" == "--remember" ]]; then
  remember=1
fi

if [[ ! "$profile_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  echo "Invalid VPN profile UUID."
  exit 2
fi

profile_type=$(nmcli -g connection.type connection show uuid "$profile_uuid" 2>/dev/null)
if [[ "$profile_type" != "vpn" ]]; then
  echo "The selected connection is not a VPN profile."
  exit 2
fi

IFS= read -r vpn_username
IFS= read -r vpn_password

vpn_data=$(nmcli -g vpn.data connection show uuid "$profile_uuid" 2>/dev/null)

vpn_data_field() {
  printf '%s\n' "$vpn_data" \
    | tr ',' '\n' \
    | sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" | head -1
}

vpn_conn_type=$(vpn_data_field connection-type)
vpn_password_flags=$(vpn_data_field password-flags)
vpn_stored_username=$(vpn_data_field username)
if [[ -z "$vpn_stored_username" ]]; then
  vpn_stored_username=$(nmcli -g vpn.user-name connection show uuid "$profile_uuid" 2>/dev/null)
fi

# An empty submission is legitimate in two cases:
#
#   * Certificate-only profiles (connection-type=tls) have no username or
#     password at all.
#   * Profiles NetworkManager can already authenticate on its own: a stored
#     username plus a system-owned password. NM_SETTING_SECRET_FLAG_NONE is 0
#     and is also the default when the flag is absent, which means the secret
#     lives in the connection rather than being asked for on each activation.
#
# Anything else still requires both fields.
cert_only=0
use_stored=0
if [[ -z "$vpn_username" && -z "$vpn_password" ]]; then
  if [[ "$vpn_conn_type" == "tls" ]]; then
    cert_only=1
  elif [[ -n "$vpn_stored_username" ]] \
    && [[ -z "$vpn_password_flags" || "$vpn_password_flags" == "0" ]]; then
    use_stored=1
  else
    echo "Username and password are required." >&2
    exit 2
  fi
elif [[ -z "$vpn_username" || -z "$vpn_password" ]]; then
  echo "Username and password are required." >&2
  exit 2
fi

if (( remember == 1 )); then
  if (( cert_only == 1 || use_stored == 1 )); then
    echo "Enter the username and password to remember." >&2
    exit 2
  fi
  # Hand the profile over to NetworkManager: it keeps the username, and
  # password-flags 0 (NM_SETTING_SECRET_FLAG_NONE) makes it store the password
  # from this activation instead of asking again. A comma is the vpn.data field
  # separator and cannot be escaped through nmcli, so a username containing one
  # is rejected rather than silently mangled.
  if [[ "$vpn_username" == *,* ]]; then
    echo "The username cannot contain a comma." >&2
    exit 2
  fi
  if ! nmcli connection modify uuid "$profile_uuid" \
    +vpn.data "username=$vpn_username, password-flags=0"; then
    echo "Could not save the credentials to the profile." >&2
    exit 2
  fi
elif (( cert_only == 0 && use_stored == 0 )); then
  nmcli connection modify uuid "$profile_uuid" vpn.user-name "$vpn_username"
fi
unset vpn_username

# Switch rather than stack VPN sessions. UUID and TYPE are intentionally the
# only fields requested, so the terse output can be parsed without profile-name
# escaping concerns.
while IFS=: read -r active_uuid active_type; do
  if [[ "$active_type" == "vpn" && "$active_uuid" != "$profile_uuid" ]]; then
    if ! nmcli connection down uuid "$active_uuid"; then
      echo "Could not disconnect the currently active VPN session." >&2
      exit 3
    fi
  fi
done < <(nmcli --terse --fields UUID,TYPE connection show --active)

# nmcli accepts its password-file data from /dev/stdin. Feed it through a pipe
# so the password exists only in process memory and is never written to disk or
# exposed in command-line arguments.
if (( cert_only == 1 || use_stored == 1 )); then
  # Nothing to feed: either the stored certificate and key are the credentials,
  # or NetworkManager holds the password itself.
  timeout --signal=TERM 25s nmcli --wait 20 connection up uuid "$profile_uuid"
else
  printf 'vpn.secrets.password:%s\n' "$vpn_password" \
    | timeout --signal=TERM 25s nmcli --wait 20 connection up uuid "$profile_uuid" passwd-file /dev/stdin
fi
connection_status=$?
unset vpn_password

if (( connection_status != 0 )); then
  if (( connection_status == 124 )); then
    echo "Connection attempt timed out. Check the credentials and try again." >&2
  fi
  exit "$connection_status"
fi

# Some OpenVPN plugins return while NetworkManager still reports "activating".
# Do not close the credential modal until the final state is known.
for ((attempt = 0; attempt < 20; attempt++)); do
  connection_state=$(nmcli -g GENERAL.STATE connection show uuid "$profile_uuid" 2>/dev/null)
  case "$connection_state" in
    activated*) exit 0 ;;
    activating*) sleep 0.5 ;;
    *)
      echo "Authentication failed or the VPN connection was rejected." >&2
      exit 4
      ;;
  esac
done

echo "Timed out waiting for the VPN connection." >&2
exit 5
