#!/bin/bash

set -euo pipefail

readonly stdout_limit=262144

case "${1:-}" in
  list)
    command=(nmcli -t --escape yes -f UUID,NAME,TYPE,DEVICE,STATE connection show)
    ;;
  details)
    # One call covers every connected profile: nmcli prints one block per
    # connection, each starting with its GENERAL.UUID line.
    shift
    if (( $# == 0 || $# > 32 )); then
      echo "Invalid VPN profile UUID." >&2
      exit 2
    fi
    command=(nmcli -t -f GENERAL.UUID,GENERAL.NAME,GENERAL.STATE,GENERAL.DEVICES,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS connection show)
    for profile_uuid in "$@"; do
      if [[ ! "$profile_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
        echo "Invalid VPN profile UUID." >&2
        exit 2
      fi
      command+=(uuid "$profile_uuid")
    done
    ;;
  *)
    echo "Usage: nmcli-query <list|details UUID...>" >&2
    exit 2
    ;;
esac

# Keep the cap reader in the foreground pipeline so all output is delivered
# before this helper exits. Quickshell closes a process channel at main-process
# exit and would otherwise discard late output from process-substitution workers.
set +e
timeout --signal=TERM --kill-after=1s 5s "${command[@]}" 2>&1 \
  | head -c "$stdout_limit"
command_status=${PIPESTATUS[0]}
set -e

exit "$command_status"
